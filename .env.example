# Copy to .env (gitignored) and fill in. Nothing here is a real value.
# Defaults below are the free, offline setup. Commented keys are optional: unset means the code's default.
# The values the show runs with are SHOW_ENV in tools/preview.py; copy those in to go live (docs/SETUP.md).

# --- Brain: mock (free) | anthropic (show)
HUBIE_PROVIDER=mock
ANTHROPIC_API_KEY=
HUBIE_ANTHROPIC_MODEL=claude-opus-5-5
# per-kind models (show: round + bit on claude-haiku-5-5; chat stays on HUBIE_ANTHROPIC_MODEL)
# HUBIE_MODEL_ROUND=
# HUBIE_MODEL_BIT=
# HUBIE_MODEL_CHAT=
# HUBIE_MODEL_CHAT_FAST=
# HUBIE_MODEL_CRISIS=
# HUBIE_MODEL_FEATURE=
HUBIE_LLM_MAX_CALLS_PER_HOUR=600
# HUBIE_SHORT_LLM_SHARE=
# HUBIE_TALK_PACE=
# HUBIE_USAGE_LOG=

# --- Voice: flite (local, offline) | mock | http | elevenlabs (show)
HUBIE_TTS=flite
ELEVENLABS_API_KEY=
# HUBIE_ELEVEN_VOICE=
# HUBIE_ELEVEN_MODEL=
HUBIE_TTS_URL=
HUBIE_TTS_KEY=
HUBIE_TTS_MODEL=
HUBIE_TTS_VOICE=

# --- Persona
HUBIE_PERSONA=persona/hubie.draft.yaml

# --- Game: fake | housebets (show, fun mode only)
HUBIE_GAME=fake
# HUBIE_HB_PROFILE=
# HUBIE_HB_RELAY=
# HUBIE_HB_TOPBAR=
# HUBIE_HB_BROWSE=
# HUBIE_HB_BONUS_BUY_MIN=
# HUBIE_HB_RECYCLE_MB=

# --- Picture: chrome | ffmpeg (show). Layout desk (show) | classic. Background art | image | x11 (show: game display)
HUBIE_SCENE=ffmpeg
HUBIE_LAYOUT=desk
HUBIE_SCENE_BG=art
HUBIE_ART_DIR=assets/placeholder
HUBIE_DISPLAY=:87
HUBIE_STAGE_PORT=18790
# desk cam loops (video files, not in git)
# HUBIE_CAM_IDLE=
# HUBIE_MOUTH_DIR=
# HUBIE_CLICK_MOUTH_DIR=
# HUBIE_CAM_ZOOM=
# HUBIE_CLICK_OFFSET_MS=
# HUBIE_REACT_WIN=
# HUBIE_REACT_LOSS=
# HUBIE_REACT_SURPRISE=
# HUBIE_REACT_BANANA=
# HUBIE_STREAM_TITLE=
HUBIE_DISK_FLOOR_GB=8

# --- Chat: fake | kick_webhook (show, Kick's documented route) | kick (undocumented socket)
HUBIE_CHAT=fake
KICK_WEBHOOK_PORT=18795
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# KICK_BROADCASTER_USER_ID=
KICK_CHATROOM_ID=
KICK_PUSHER_URL=
# HUBIE_FILL_AFTER=

# --- Output: file:<dir>, hls:<absolute dir>, or a loopback rtmp:// URL. A remote URL (Kick ingest + stream key)
# is refused unless HUBIE_ALLOW_REMOTE_OUTPUT is set to the exact phrase in hubie/pipeline/output_guard.py.
HUBIE_OUTPUT=file:recordings
HUBIE_ALLOW_REMOTE_OUTPUT=
HUBIE_VIDEO_BITRATE=2500k
HUBIE_X264_PRESET=veryfast

# --- Watchdog (show: dead air 30 s, brain + game Chrome memory 2600 MB)
# HUBIE_WD_DEAD_AIR=
# HUBIE_WD_RSS_BRAIN_MB=

# --- Private preview host (tools/preview.py) and Kling (only to render new cam loops)
HUBIE_PREVIEW_DOMAIN=
KLING_API_KEY=

# upstream proxy the game Chrome goes through (tools/housebets/relay.py): http://user:pass@host:port
HUBIE_GAMES_PROXY=
